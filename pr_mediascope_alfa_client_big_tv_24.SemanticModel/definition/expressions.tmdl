expression end_date_report =
		let
		    nat_tv_simple_date = Table.TransformColumnTypes(
		                            Sql.Database(mssql_server, db_name, [Query="select max(researchDate) as nat_tv_simple_min_date from nat_tv_simple"]),
		                             {{"nat_tv_simple_min_date", type date}})[nat_tv_simple_min_date]{0},
		    reg_tv_simple_date = Table.TransformColumnTypes(
		                            Sql.Database(mssql_server, db_name, [Query="select max(researchDate) as reg_tv_simple_min_date from reg_tv_simple"]),
		                            {{"reg_tv_simple_min_date", type date}})[reg_tv_simple_min_date]{0},
		    big_tv_simple_date = Table.TransformColumnTypes(
		                            Sql.Database(mssql_server, db_name, [Query="select max(researchDate) as big_tv_simple_min_date from big_tv_simple"]),
		                            {{"big_tv_simple_min_date", type date}})[big_tv_simple_min_date]{0},
		    calendar_max_date = List.Max({nat_tv_simple_date, reg_tv_simple_date, big_tv_simple_date})
		
		in
		    calendar_max_date
