expression end_date_Adex_filter_DB = ```
		let
		cur_date = DateTime.LocalNow(),
		cur_day_num = Date.Day(cur_date),
		
		/* month_count = if 1 < cur_day_num and  cur_day_num <= 5 then -3 else -2, */
		month_count = if cur_day_num <= 5 then -3 else -2,
		
		last_n_months = Date.From(Date.AddMonths(cur_date, month_count)), 
		end_date = Date.ToText(
		    #date(Date.Year(last_n_months), Date.Month(last_n_months), 1), 
		    [Format="yyyy-MM-dd", Culture="en-EN"]
		    )
		
		
		in
		    end_date
		```
