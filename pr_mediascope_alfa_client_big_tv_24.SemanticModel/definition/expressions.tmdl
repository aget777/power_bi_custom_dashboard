	annotation PBI_ResultType = Function

expression start_date =
		let
		    media_costs_union_date = Table.TransformColumnTypes(
		                            Sql.Database(mssql_server, db_name, [Query="select min(researchDate) as all_media_costs_min_date from media_costs_union_view"]),
		                            {{"all_media_costs_min_date", type date}})[all_media_costs_min_date]{0},
		    nat_tv_simple_date = Table.TransformColumnTypes(
		                            Sql.Database(mssql_server, db_name, [Query="select min(researchDate) as nat_tv_simple_min_date from nat_tv_simple"]),
		                            {{"nat_tv_simple_min_date", type date}})[nat_tv_simple_min_date]{0},
		    reg_tv_simple_date = Table.TransformColumnTypes(
		                            Sql.Database(mssql_server, db_name, [Query="select min(researchDate) as reg_tv_simple_min_date from reg_tv_simple"]),
		                            {{"reg_tv_simple_min_date", type date}})[reg_tv_simple_min_date]{0},
		
		    big_tv_simple_date = Table.TransformColumnTypes(
		                            Sql.Database(mssql_server, db_name, [Query="select min(researchDate) as big_tv_simple_min_date from big_tv_simple"]),
		                            {{"big_tv_simple_min_date", type date}})[big_tv_simple_min_date]{0},
		
		    calendar_min_date = List.Min({media_costs_union_date, nat_tv_simple_date, reg_tv_simple_date, big_tv_simple_date}),
		    tmp = Date.From("01.01.2026")
		
		in
		    tmp
