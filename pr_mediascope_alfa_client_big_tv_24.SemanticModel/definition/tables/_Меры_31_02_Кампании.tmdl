				                            "__tvr", CALCULATE(
				                                [3442_01_TPR_Имидж_TOP_Category_6],
				                                KEEPFILTERS('category_6_Top'[category_6_main_Top] = ProductName),
				                                KEEPFILTERS('brand_main_Top'[brand_main_top] = BrandName)
				                            ),
				                            "__sov", CALCULATE(
				                                [3442_02_SOV_%_Имидж_Кампании],
				                                KEEPFILTERS('category_6_Top'[category_6_main_Top] = ProductName),
				                                KEEPFILTERS('brand_main_Top'[brand_main_top] = BrandName)
				                            ),
					                            "__offerName", 'all_reports_ad_dict'[category_12],
					                            "__offerLink", CALCULATE(
