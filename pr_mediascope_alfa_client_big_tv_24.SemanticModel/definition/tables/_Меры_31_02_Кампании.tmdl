	measure 3432_10_html_business_campaigns_detail =
			
				VAR TvrFormat = "#,0.0"
				VAR PercentFormat = "0%"
				VAR TotalTvr = [3432_01_TPR_Бизнес_TOP_Category_6]
				VAR TopProducts =
				    FILTER(
				        ADDCOLUMNS(
				            VALUES('category_6_Top'[category_6_main_Top]),
				            "__tvr", [3432_01_TPR_Бизнес_TOP_Category_6],
				            "__sov", [3432_02_SOV_%_Бизнес_TOP_Кампании],
				            "__name", 'category_6_Top'[category_6_main_Top],
				            "__isOther", IF(LOWER('category_6_Top'[category_6_main_Top]) = "остальное", 1, 0)
				        ),
				        NOT ISBLANK([__tvr]) && [__tvr] <> 0 && NOT ISBLANK([__name])
				    )
				VAR DetailProducts =
				    FILTER(
				        TopProducts,
				        LOWER([__name]) <> "остальное"
				            && LOWER([__name]) <> "прочие сегменты"
				    )
				VAR ProductMaxSov = MAXX(TopProducts, [__sov])
				VAR ProductCards =
				    CONCATENATEX(
				        TopProducts,
				        VAR ProductName = [__name]
				        VAR ProductSov = [__sov]
				        VAR ProductIsOther = [__isOther]
				        VAR ProductRank = RANKX(FILTER(TopProducts, [__isOther] = 0), [__sov], ProductSov, DESC, Dense)
				        VAR Accent =
				            IF(
				                ProductIsOther = 1,
				                "#9AA3B2",
				                SWITCH(
				                    ProductRank,
				                    1, "#63D7BE",
				                    2, "#E2C16F",
				                    3, "#EF6B78",
				                    4, "#5BAFE0",
				                    5, "#B58CFF",
				                    "#9AA3B2"
				                )
				            )
				        RETURN
				            "<div class='rt-segment-card' style='--accent:" & Accent & "'>"
				                & "<div class='rt-segment-mark'></div>"
				                & "<div class='rt-segment-name'>" & ProductName & "</div>"
				                & "<div class='rt-segment-value'>" & FORMAT(ProductSov, PercentFormat) & "</div>"
				            & "</div>",
				        "",
				        [__isOther], ASC,
			        [__sov], DESC,
			        [__name], ASC
				    )
				VAR ProductSections =
				    CONCATENATEX(
				        DetailProducts,
				        VAR ProductName = [__name]
				        VAR ProductTvr = [__tvr]
				        VAR ProductSov = [__sov]
				        VAR ProductIsOther = [__isOther]
				        VAR ProductRank = RANKX(FILTER(TopProducts, [__isOther] = 0), [__sov], ProductSov, DESC, Dense)
				        VAR Accent =
				            IF(
				                ProductIsOther = 1,
				                "#9AA3B2",
				                SWITCH(
				                    ProductRank,
				                    1, "#63D7BE",
				                    2, "#E2C16F",
				                    3, "#EF6B78",
				                    4, "#5BAFE0",
				                    5, "#B58CFF",
				                    "#9AA3B2"
				                )
				            )
				        VAR Brands =
				            FILTER(
				                ADDCOLUMNS(
				                    ALLSELECTED('brand_main_Top'[brand_main_top]),
				                    "__tvr", CALCULATE([3432_01_TPR_Бизнес_TOP_Category_6], KEEPFILTERS('category_6_Top'[category_6_main_Top] = ProductName)),
				                    "__sov", CALCULATE([3432_02_SOV_%_Бизнес_TOP_Кампании], KEEPFILTERS('category_6_Top'[category_6_main_Top] = ProductName)),
				                    "__offer", CALCULATE([3432_05_Бизнес_Оффер_not_blank], KEEPFILTERS('category_6_Top'[category_6_main_Top] = ProductName)),
					                    "__logo", CALCULATE(SELECTEDVALUE('logos_dict'[logo_link]), KEEPFILTERS('category_6_Top'[category_6_main_Top] = ProductName)),
					                    "__brand", 'brand_main_Top'[brand_main_top]
				                ),
				                NOT ISBLANK([__tvr]) && [__tvr] <> 0
				                    && NOT ISBLANK([__brand])
				                    && [__brand] <> "ОСТАЛЬНОЕ"
				            )
				        VAR BrandRows =
				            CONCATENATEX(
				                Brands,
				                VAR BrandName = [__brand]
				                VAR BrandTvr = [__tvr]
				                VAR BrandSov = [__sov]
				                VAR BrandOffers = [__offer]
				                VAR BrandInitial = LEFT(BrandName, 1)
					                VAR BrandLogoRaw =
					                    IF(
					                        BrandName = "OZON+OZON БАНК",
					                        LOOKUPVALUE('logos_dict'[logo_link], 'logos_dict'[brand_name], "OZON БАНК"),
					                        [__logo]
					                    )
					                VAR BrandLogo =
					                    SUBSTITUTE(
					                        SUBSTITUTE(BrandLogoRaw, "'", "%27"),
					                        """", "%22"
					                    )
					                VAR BrandLogoHtml =
					                    IF(
					                        NOT ISBLANK(BrandLogo) && BrandLogo <> "",
					                        "<span class='rt-logo'><img class='rt-logo-img' src='" & BrandLogo & "'></span>",
					                        "<span class='rt-logo rt-logo-fallback'>" & BrandInitial & "</span>"
					                    )
					                VAR BrandBarWidth = MIN(100, ROUND(BrandSov * 100, 0))
				                VAR Offers =
				                    FILTER(
				                        ADDCOLUMNS(
				                            VALUES('all_reports_ad_dict'[category_12]),
				                            "__tvr", CALCULATE(
				                                [3432_01_TPR_Бизнес_TOP_Category_6],
				                                KEEPFILTERS('category_6_Top'[category_6_main_Top] = ProductName),
				                                KEEPFILTERS('brand_main_Top'[brand_main_top] = BrandName)
				                            ),
				                            "__sov", CALCULATE(
				                                [3432_02_SOV_%_Бизнес_TOP_Кампании],
				                                KEEPFILTERS('category_6_Top'[category_6_main_Top] = ProductName),
				                                KEEPFILTERS('brand_main_Top'[brand_main_top] = BrandName)
				                            ),
					                            "__offerName", 'all_reports_ad_dict'[category_12],
					                            "__offerLink", CALCULATE(
					                                FIRSTNONBLANK('creatives_dict'[creative_link], 1),
					                                KEEPFILTERS('category_6_Top'[category_6_main_Top] = ProductName),
					                                KEEPFILTERS('brand_main_Top'[brand_main_top] = BrandName),
					                                'creatives_dict'[creative_link] <> ""
					                            )
				                        ),
				                        NOT ISBLANK([__tvr]) && [__tvr] <> 0
				                            && NOT ISBLANK([__offerName])
				                            && [__offerName] <> ""
				                    )
				                VAR OfferRows =
				                    CONCATENATEX(
				                        Offers,
				                        VAR OfferName = [__offerName]
				                        VAR OfferTvr = [__tvr]
				                        VAR OfferSov = [__sov]
				                        VAR OfferLinkRaw = [__offerLink]
				                        VAR OfferLinkText = TRIM(OfferLinkRaw)
				                        VAR OfferLinkWithProtocol =
				                            IF(
				                                NOT ISBLANK(OfferLinkText) && OfferLinkText <> "" && LEFT(LOWER(OfferLinkText), 4) <> "http",
				                                "https://" & OfferLinkText,
				                                OfferLinkText
				                            )
				                        VAR OfferLink =
				                            SUBSTITUTE(
				                                SUBSTITUTE(OfferLinkWithProtocol, "'", "%27"),
				                                """", "%22"
				                            )
				                        VAR OfferRowStart =
				                            IF(
				                                NOT ISBLANK(OfferLink) && OfferLink <> "",
				                                "<a class='rt-row rt-offer-row rt-offer-link' href='" & OfferLink & "' target='_blank' rel='noopener noreferrer'>",
				                                "<div class='rt-row rt-offer-row'>"
				                            )
				                        VAR OfferRowEnd =
				                            IF(
				                                NOT ISBLANK(OfferLink) && OfferLink <> "",
				                                "</a>",
				                                "</div>"
				                            )
					                        VAR OfferBarWidth = MIN(100, ROUND(OfferSov * 100, 0))
				                        RETURN
				                            OfferRowStart
				                                & "<div class='rt-rank'></div>"
				                                & "<div class='rt-name rt-offer-name'>↳ " & OfferName & "</div>"
				                                & "<div class='rt-offer-badge rt-offer-badge-empty'></div>"
				                                & "<div class='rt-tvr'>" & FORMAT(OfferTvr, TvrFormat) & "</div>"
				                                & "<div class='rt-sov-cell'><div class='rt-track'><div class='rt-fill' style='width:" & FORMAT(OfferBarWidth, "0") & "%'></div></div><span>" & FORMAT(OfferSov, PercentFormat) & "</span></div>"
				                            & OfferRowEnd,
				                        "",
				                        [__tvr], DESC,
				                        [__offerName], ASC
				                    )
				                RETURN
				                    "<div class='rt-brand-block'>"
				                        & "<div class='rt-row rt-brand-row'>"
				                            & "<div class='rt-rank'>" & FORMAT(RANKX(Brands, [__tvr], BrandTvr, DESC, Dense), "0") & "</div>"
				                            & "<div class='rt-name rt-brand-name'>" & BrandLogoHtml & "<span>" & BrandName & "</span></div>"
				                            & "<div class='rt-offer-badge'>" & FORMAT(BrandOffers, "0") & "</div>"
				                            & "<div class='rt-tvr'>" & FORMAT(BrandTvr, TvrFormat) & "</div>"
				                            & "<div class='rt-sov-cell'><div class='rt-track'><div class='rt-fill' style='width:" & FORMAT(BrandBarWidth, "0") & "%'></div></div><span>" & FORMAT(BrandSov, PercentFormat) & "</span></div>"
				                        & "</div>"
				                        & OfferRows
				                    & "</div>",
				                "",
				                [__tvr], DESC,
				                [__brand], ASC
				            )
				        RETURN
				            "<section class='rt-product' style='--accent:" & Accent & "'>"
				                & "<div class='rt-product-head'>"
				                    & "<div class='rt-product-title'><span></span>" & ProductName & "</div>"
				                    & "<div class='rt-product-total'>" & FORMAT(ProductTvr, TvrFormat) & " TVR · " & FORMAT(ProductSov, PercentFormat) & "</div>"
				                & "</div>"
				                & "<div class='rt-table-head'><div></div><div></div><div>ОФФЕР</div><div>TVR</div><div>SOV</div></div>"
				                & IF(ISEMPTY(Brands), "<div class='rt-empty'>Нет данных</div>", BrandRows)
				            & "</section>",
				        "",
				        [__isOther], ASC,
			        [__sov], DESC,
			        [__name], ASC
				    )
				RETURN
				"<div class='rt-wrap'>"
				    & "<style>"
				    & ".rt-wrap{width:100%;height:auto;min-height:100%;box-sizing:border-box;background:#0F1722;border:1px solid #1C2739;border-radius:8px;padding:18px 22px 24px;font-family:Segoe UI,Arial,sans-serif;color:#E3EAF2;overflow:visible;}"
				    & ".rt-top{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:18px;}"
				    & ".rt-title{display:flex;align-items:center;gap:12px;font-size:28px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#E3EAF2;}"
				    & ".rt-title:before{content:'';width:15px;height:15px;border:2px solid #9AA3B2;box-shadow:inset 0 0 0 3px #0F1722;background:#263244;display:inline-block;}"
				    & ".rt-total{display:flex;align-items:baseline;gap:14px;padding:10px 18px 9px;background:#0A0E19;color:#E3EAF2;font-size:20px;font-weight:800;letter-spacing:1px;text-transform:uppercase;white-space:nowrap;}"
				    & ".rt-total span:last-child{font-size:24px;}"
				    & ".rt-segments{display:grid;grid-template-columns:repeat(3,1fr);gap:12px 14px;margin-bottom:12px;}"
				    & ".rt-segment-card{height:62px;border:2px solid var(--accent);border-radius:8px;display:grid;grid-template-columns:9px 1fr auto;gap:13px;align-items:center;padding:0 16px;background:#0B1624;box-shadow:0 0 0 1px rgba(255,255,255,.03) inset;}"
				    & ".rt-segment-mark{width:7px;height:31px;background:var(--accent);}"
				    & ".rt-segment-name{font-size:15px;font-weight:850;color:var(--accent);text-transform:uppercase;line-height:1.05;}"
				    & ".rt-segment-value{font-size:25px;font-weight:850;color:var(--accent);}"
				    & ".rt-empty{padding:18px 0;color:#9AA3B2;font-size:14px;}"
				    & ".rt-product{border-left:5px solid var(--accent);padding:0 0 4px 20px;margin-top:18px;}"
				    & ".rt-product+.rt-product{border-top:1px solid #1C2739;padding-top:13px;}"
				    & ".rt-product-head{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:14px;}"
				    & ".rt-product-title{font-size:18px;font-weight:850;color:var(--accent);letter-spacing:2px;text-transform:uppercase;display:flex;align-items:center;gap:12px;}"
				    & ".rt-product-title span{width:4px;height:34px;background:var(--accent);display:none;}"
				    & ".rt-product-total{font-size:16px;font-weight:800;color:#E3EAF2;white-space:nowrap;}"
				    & ".rt-table-head,.rt-row{display:grid;grid-template-columns:38px minmax(420px,1fr) 92px 112px 220px;gap:12px;align-items:center;}"
				    & ".rt-table-head{margin-bottom:5px;color:#6F7B8F;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:1px;text-align:right;}"
				    & ".rt-table-head div:nth-child(2){text-align:left;}"
				    & ".rt-row{min-height:34px;border-bottom:1px solid rgba(28,39,57,.72);}"
				    & ".rt-brand-block{padding:3px 0 9px;}"
				    & ".rt-brand-block+.rt-brand-block{margin-top:4px;}"
				    & ".rt-brand-row{min-height:46px;}"
				    & ".rt-rank{color:#7F8A9C;font-size:13px;text-align:left;}"
				    & ".rt-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}"
				    & ".rt-brand-name{display:flex;align-items:center;gap:14px;color:#E3EAF2;font-size:16px;font-weight:850;text-transform:uppercase;}"
				    & ".rt-logo{width:40px;height:28px;border-radius:8px;background:#F0F3F7;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 0 rgba(255,255,255,.18) inset;flex:0 0 40px;overflow:hidden;} .rt-logo-img{width:100%;height:100%;object-fit:contain;display:block;} .rt-logo-fallback{color:var(--accent);font-weight:900;font-size:13px;}"
				    & ".rt-offer-row{min-height:38px;}"
				    & ".rt-offer-row+.rt-offer-row{margin-top:3px;}"
				    & ".rt-offer-name{color:#7E8798;font-size:13px;line-height:1.25;padding-left:52px;}"
				    & ".rt-row.rt-offer-link{color:inherit;text-decoration:none;cursor:pointer;}"
				    & ".rt-row.rt-offer-link:hover .rt-offer-name{color:var(--accent);text-decoration:underline;}"
				    & ".rt-offer-badge{justify-self:center;min-width:36px;height:30px;border-radius:8px;background:var(--accent);color:#06121C;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:900;}"
				    & ".rt-offer-badge-empty{background:transparent;color:transparent;box-shadow:none;}"
				    & ".rt-tvr{text-align:right;color:#D8DEE8;font-size:14px;}"
				    & ".rt-offer-row .rt-tvr,.rt-offer-row .rt-sov-cell span{color:#7E8798;font-size:12px;}"
				    & ".rt-sov-cell{display:grid;grid-template-columns:1fr 48px;gap:10px;align-items:center;color:#D8DEE8;font-size:13px;text-align:right;}"
				    & ".rt-track{height:9px;border-radius:999px;background:#1B2A3B;box-shadow:0 0 0 1px rgba(255,255,255,.02) inset;overflow:hidden;}"
				    & ".rt-fill{height:100%;border-radius:999px;background:var(--accent);}"
				    & ".rt-offer-row .rt-fill{opacity:.42;}"
				    & "</style>"
				    & "<div class='rt-top'><div class='rt-title'>Бизнес</div><div class='rt-total'><span>TVR</span><span>" & FORMAT(TotalTvr, TvrFormat) & "</span></div></div>"
				    & "<div class='rt-segments'>" & IF(ISEMPTY(TopProducts), "<div class='rt-empty'>Нет данных</div>", ProductCards) & "</div>"
				    & IF(ISEMPTY(DetailProducts), "", ProductSections)
				& "</div>"
		isHidden
		displayFolder: 04_Бизнес_Кампании
		lineageTag: c1be8912-7784-4fd2-9a70-a4fefc8708ea

		changedProperty = IsHidden

	measure 3442_05_Имидж_Оффер_not_blank =
