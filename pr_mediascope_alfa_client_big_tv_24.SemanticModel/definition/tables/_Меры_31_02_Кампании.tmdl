					                                KEEPFILTERS('category_6_Top'[category_6_main_Top] = ProductName),
					                                KEEPFILTERS('brand_main_Top'[brand_main_top] = BrandName),
					                                'creatives_dict'[creative_link] <> ""
					                            )
				                        ),
				                        NOT ISBLANK([__tvr]) && [__tvr] <> 0
