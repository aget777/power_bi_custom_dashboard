				                    "__tvr", CALCULATE([3442_01_TPR_Имидж_TOP_Category_6], KEEPFILTERS('category_6_Top'[category_6_main_Top] = ProductName)),
				                    "__sov", CALCULATE([3442_02_SOV_%_Имидж_Кампании], KEEPFILTERS('category_6_Top'[category_6_main_Top] = ProductName)),
				                    "__offer", CALCULATE([3442_05_Имидж_Оффер_not_blank], KEEPFILTERS('category_6_Top'[category_6_main_Top] = ProductName)),
					                    "__logo", CALCULATE(SELECTEDVALUE('logos_dict'[logo_link]), KEEPFILTERS('category_6_Top'[category_6_main_Top] = ProductName)),
					                    "__brand", 'brand_main_Top'[brand_main_top]
