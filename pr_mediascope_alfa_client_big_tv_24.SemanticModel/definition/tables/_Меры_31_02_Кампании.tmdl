	measure 3432_05_Бизнес_Оффер_not_blank =
			if(ISINSCOPE('all_reports_ad_dict'[category_12]), BLANK(),
			    CALCULATE([3403_00_Оффер_all],
			FILTER('all_reports_ad_dict', [3432_01_TPR_Бизнес_TOP_Category_6] > 0)))
		formatString: 0
