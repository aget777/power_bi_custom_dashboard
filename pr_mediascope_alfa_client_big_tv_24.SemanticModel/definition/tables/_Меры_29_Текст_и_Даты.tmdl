	measure 2902_05_switch_creatives =
			
			var switch_creative =
			If(HASONEVALUE('all_reports_ad_dict'[media_type]),
			SWITCH(VALUES('all_reports_ad_dict'[media_type]),
			"OD", [2902_01_Html_Img],
			"PR", [2902_01_Html_Img],
			"TV", [2902_03_Html_Video],
			"RA", [2902_02_Html_Audio]))
			
			var result = if(
			    ISBLANK([2902_00_SelectedLink]) && or(
			    ISBLANK(CALCULATE(SELECTEDVALUE('all_reports_ad_dict'[media_type]), ALL('media_type_dict'))),
			    SELECTEDVALUE('media_type_dict'[media_type])="TV"),
			     [2902_04_02_NOT_Selected_DefaultImgLink],
			     if(ISBLANK([2902_00_SelectedLink]) ||  [2902_00_SelectedLink]="", [2902_04_01_Selected_DefaultImgLink],
			     switch_creative))
			return result
		isHidden
		displayFolder: 29_02_HTML\01_Main_HTML
		lineageTag: 29918bcd-2035-4a7f-a708-c47f2453522b

		changedProperty = IsHidden

