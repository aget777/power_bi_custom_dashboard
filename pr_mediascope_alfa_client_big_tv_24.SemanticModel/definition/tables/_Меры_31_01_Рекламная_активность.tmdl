	measure 3202_04_html_top3_image =
			
			VAR MetricFormat = "#,0"
			VAR ImageSov = [3141_02_SOV_%_общ_Имидж]
			VAR ImageSovText =
			    IF(
			        ISBLANK(ImageSov),
			        "",
			        " (" & FORMAT(ImageSov, "0%") & " АКТИВНОСТИ)"
			    )
			VAR BrandsBase =
			    ADDCOLUMNS(
			        FILTER(
			            ALLSELECTED('brand_main_Top'[brand_main_top]),
			            NOT ISBLANK('brand_main_Top'[brand_main_top])
			                && 'brand_main_Top'[brand_main_top] <> "ОСТАЛЬНОЕ"
			        ),
			        "__value", [3142_01_TPR_Имидж],
			        "__sov", [3142_02_SOV_%_Имидж],
			        "__logo", CALCULATE(SELECTEDVALUE('logos_dict'[logo_link]))
			    )
			VAR BrandsFiltered =
			    FILTER(
			        BrandsBase,
			        NOT ISBLANK([__value]) && [__value] >= 1
			            && 'brand_main_Top'[brand_main_top] <> "OZON+OZON БАНК"
			    )
			VAR TopBrands =
			    TOPN(
			        3,
			        BrandsFiltered,
			        [__value], DESC,
			        'brand_main_Top'[brand_main_top], ASC
			    )
			VAR MaxValue = MAXX(TopBrands, [__value])
			VAR RowsHtml =
			    CONCATENATEX(
			        TopBrands,
			        VAR BrandRaw = 'brand_main_Top'[brand_main_top]
			        VAR Brand =
			            SUBSTITUTE(
			                SUBSTITUTE(
			                    SUBSTITUTE(
			                        SUBSTITUTE(BrandRaw, "&", "&amp;"),
			                        "<", "&lt;"
			                    ),
			                    ">", "&gt;"
			                ),
			                "'", "&#39;"
			            )
			        VAR MetricValue = [__value]
			        VAR SovValue = [__sov]
			        VAR LogoRaw = [__logo]
			        VAR Logo =
			            SUBSTITUTE(
			                SUBSTITUTE(LogoRaw, "'", "%27"),
			                """", "%22"
			            )
			        VAR RankNo =
			            COUNTROWS(
			                FILTER(
			                    TopBrands,
			                    [__value] > MetricValue
			                        || (
			                            [__value] = MetricValue
			                                && 'brand_main_Top'[brand_main_top] <= BrandRaw
			                        )
			                )
			            )
			        VAR BarWidth = ROUND(DIVIDE(MetricValue, MaxValue, 0) * 100, 0) & "%"
			        VAR FirstLetter = LEFT(BrandRaw, 1)
			        VAR LogoHtml =
			            IF(
			                NOT ISBLANK(Logo) && Logo <> "",
			                "<img class='image-logo' src='" & Logo & "'>",
			                "<div class='image-logo image-logo-fallback'>" & FirstLetter & "</div>"
			            )
			        RETURN
			            "<div class='image-row'>"
			                & "<div class='image-rank'>" & RankNo & "</div>"
			                & LogoHtml
			                & "<div class='image-brand' title='" & Brand & "'>" & Brand & "</div>"
			                & "<div class='image-value'>" & FORMAT(MetricValue, MetricFormat) & " TRP</div>"
			                & "<div class='image-bar-track'><div class='image-bar-fill' style='width:" & BarWidth & ";'></div></div>"
			                & "<div class='image-sov'>" & IF(ISBLANK(SovValue), "", FORMAT(SovValue, "0%") & " SOV") & "</div>"
			            & "</div>",
			        "",
			        [__value], DESC,
			        'brand_main_Top'[brand_main_top], ASC
			    )
			VAR SegmentsBase =
			    ADDCOLUMNS(
			        FILTER(
			            ALLSELECTED('all_reports_ad_dict'[category_6]),
			            NOT ISBLANK('all_reports_ad_dict'[category_6])
			        ),
			        "__value", CALCULATE([3142_01_TPR_Имидж]),
			        "__sov", CALCULATE([3143_02_SOV_%_Имидж_сегменты])
			    )
			VAR TopSegments =
			    TOPN(
			        3,
			        FILTER(
			            SegmentsBase,
			            NOT ISBLANK([__sov]) && [__sov] > 0
			        ),
			        [__sov], DESC,
			        'all_reports_ad_dict'[category_6], ASC
			    )
			VAR SegmentRowsHtml =
			    CONCATENATEX(
			        TopSegments,
			        VAR SegmentRaw = 'all_reports_ad_dict'[category_6]
			        VAR Segment =
			            SUBSTITUTE(
			                SUBSTITUTE(
			                    SUBSTITUTE(
			                        SUBSTITUTE(SegmentRaw, "&", "&amp;"),
			                        "<", "&lt;"
			                    ),
			                    ">", "&gt;"
			                ),
			                "'", "&#39;"
			            )
			        VAR SegmentSov = [__sov]
			        VAR RankNo =
			            COUNTROWS(
			                FILTER(
			                    TopSegments,
			                    [__sov] > SegmentSov
			                        || (
			                            [__sov] = SegmentSov
			                                && 'all_reports_ad_dict'[category_6] <= SegmentRaw
			                        )
			                )
			            )
			        VAR SegmentClass =
			            SWITCH(
			                RankNo,
			                1, "image-segment-1",
			                2, "image-segment-2",
			                "image-segment-3"
			            )
			        RETURN
			            "<div class='image-segment " & SegmentClass & "'>"
			                & "<div class='image-segment-mark'></div>"
			                & "<div class='image-segment-label' title='" & Segment & "'>" & Segment & "</div>"
			                & "<div class='image-segment-value'>" & FORMAT(SegmentSov, "0%") & "</div>"
			            & "</div>",
			        "",
			        [__sov], DESC,
			        'all_reports_ad_dict'[category_6], ASC
			    )
			VAR SegmentsHtml =
			    "<div class='image-segments'>"
			        & "<div class='image-segments-title'>ИМИДЖ-СЕГМЕНТЫ</div>"
			        & IF(
			            ISEMPTY(TopSegments),
			            "<div class='image-segment-empty'>Нет данных</div>",
			            "<div class='image-segment-grid'>" & SegmentRowsHtml & "</div>"
			        )
			    & "</div>"
			VAR EmptyHtml =
			    "<div class='image-empty'>Нет данных</div>"
			RETURN
			    "<div class='image-card'>"
			        & "<style>"
			        & ".image-card{width:100%;height:100%;box-sizing:border-box;background:#0F1722;border:1px solid #1C2739;border-radius:8px;padding:16px 18px;font-family:Segoe UI,Arial,sans-serif;color:#E3EAF2;overflow:hidden;}"
			        & ".image-head{height:26px;display:flex;align-items:center;gap:12px;font-size:14px;font-weight:800;letter-spacing:4px;text-transform:uppercase;color:#B58CFF;}"
			        & ".image-icon{width:22px;height:22px;color:#B58CFF;display:inline-flex;align-items:center;justify-content:center;flex:0 0 22px;}"
			        & ".image-icon svg{width:22px;height:22px;display:block;}"
			        & ".image-head-sov{color:#B58CFF;letter-spacing:2px;}"
			        & ".image-rows{margin-top:10px;display:flex;flex-direction:column;gap:5px;}"
			        & ".image-row{height:27px;display:grid;grid-template-columns:22px 34px minmax(118px,1fr) 96px 126px 52px;gap:8px;align-items:center;}"
			        & ".image-rank{color:#9AA3B2;font-size:13px;text-align:right;}"
			        & ".image-logo{width:30px;height:30px;border-radius:7px;object-fit:contain;background:#FFFFFF;display:flex;align-items:center;justify-content:center;}"
			        & ".image-logo-fallback{background:#1C2739;color:#B58CFF;font-weight:800;font-size:14px;}"
			        & ".image-brand{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#E3EAF2;font-size:14px;font-weight:650;}"
			        & ".image-value{white-space:nowrap;color:#9AA3B2;font-size:12px;text-align:right;}"
			        & ".image-bar-track{height:8px;background:#1C2739;border-radius:999px;overflow:hidden;}"
			        & ".image-bar-fill{height:100%;background:#B58CFF;border-radius:999px;}"
			        & ".image-sov{white-space:nowrap;color:#9AA3B2;font-size:13px;font-weight:400;text-align:right;}"
			        & ".image-empty{height:92px;display:flex;align-items:center;justify-content:center;color:#9AA3B2;font-size:14px;}"
			        & ".image-segments{margin-top:16px;border-top:1px solid #1C2739;padding-top:12px;}"
			        & ".image-segments-title{color:#9AA3B2;font-size:10px;font-weight:800;letter-spacing:3px;text-transform:uppercase;}"
			        & ".image-segment-grid{margin-top:9px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;}"
			        & ".image-segment{min-width:0;height:52px;border:2px solid;border-radius:6px;background:#0F1722;padding:9px 9px;box-sizing:border-box;display:grid;grid-template-columns:7px minmax(0,1fr) 54px;gap:10px;align-items:center;}"
			        & ".image-segment-mark{width:7px;height:30px;border-radius:1px;}"
			        & ".image-segment-label{min-width:0;color:#E3EAF2;font-size:10px;font-weight:800;line-height:1.12;text-transform:uppercase;white-space:normal;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;}"
			        & ".image-segment-value{font-size:20px;font-weight:900;line-height:1;text-align:right;}"
			        & ".image-segment-empty{height:52px;margin-top:9px;display:flex;align-items:center;justify-content:center;color:#9AA3B2;font-size:14px;}"
			        & ".image-segment-1{border-color:#B58CFF;}.image-segment-1 .image-segment-mark{background:#B58CFF;}.image-segment-1 .image-segment-value{color:#B58CFF;}"
			        & ".image-segment-2{border-color:#E2C16F;}.image-segment-2 .image-segment-mark{background:#E2C16F;}.image-segment-2 .image-segment-value{color:#E2C16F;}"
			        & ".image-segment-3{border-color:#EF6B78;}.image-segment-3 .image-segment-mark{background:#EF6B78;}.image-segment-3 .image-segment-value{color:#EF6B78;}"
			        & "</style>"
			        & "<div class='image-head'><span class='image-icon'><svg viewBox='0 0 24 24' aria-hidden='true'><path fill='currentColor' d='M12 3 2 9l10 6 8-4.8V17h2V9L12 3Zm0 2.3L17.6 9 12 12.4 6.4 9 12 5.3ZM6 13.2v4.1c1.8 1.8 3.8 2.7 6 2.7s4.2-.9 6-2.7v-4.1l-6 3.6-6-3.6Z'/></svg></span><span>ТОП-3 • ИМИДЖ<span class='image-head-sov'>" & ImageSovText & "</span></span></div>"
			        & IF(ISEMPTY(TopBrands), EmptyHtml, "<div class='image-rows'>" & RowsHtml & "</div>")
			        & SegmentsHtml
			    & "</div>"
		lineageTag: 2d6d3b0a-9cfe-49c9-9994-16d9fb6a1115

